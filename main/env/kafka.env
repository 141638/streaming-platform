# Host clients (Spring apps running on your machine) use localhost with the published
# ports below. Containers on the streaming network use the internal BROKER listener:
# kafka-kraft-{1,2,3}:9099.
#
# Multi-broker KRaft cluster (apache/kafka:4.1.2):
#   Broker 1: localhost:19091 → container :9092
#   Broker 2: localhost:19092 → container :9092
#   Broker 3: localhost:19093 → container :9092
#
# Single-broker alternative (see main/docker/kafka/single-broker/):
#   localhost:9094 → container :9092

# Comma-separated list of all bootstrap brokers for the multi-broker cluster
KAFKA_BOOTSTRAP_SERVERS=localhost:19091,localhost:19092,localhost:19093

# Legacy — kept for single-broker alternative
KAFKA_HOST_PUBLISH_PORT=19091
ALLOW_PLAINTEXT_LISTENER=yes
